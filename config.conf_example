# WebUI transport is independent of the optional Caddyfile export.
#choices: tcp unix
CITADEL_WEBUI_TRANSPORT=tcp

# Unix transport only. Empty uses $XDG_RUNTIME_DIR/citadel/citadel.sock,
# or /run/citadel/citadel.sock when XDG_RUNTIME_DIR is not set.
#when: CITADEL_WEBUI_TRANSPORT=unix
CITADEL_WEBUI_SOCKET=

#publish-host: FASTAPI_HOST
#required: FastAPI bind host
FASTAPI_HOST=127.0.0.1

#required: CITADEL internal web UI port
CITADEL_WEBUI_PORT=11000

# Hide only this WebUI's duplicate HTTP tile while the same instance is
# reachable through a working scanned HTTPS frontend. Backends remain routable.
#choices: 0 1
#default-preset: 1
CITADEL_HIDE_HTTP_WEBUI_DUPE=1

# Optional Caddyfile export. Empty/0 disables generation, not the WebUI.
# The caddy extension's config.json specifies Caddy's hosts and backend address.
CADDYFILE_START=

# Empty uses 1. Existing backend ports retain their assigned frontend ports.
CADDYFILE_STEPS=1

# 0 rebuilds Tailscale Serve routes from scratch on every scan.
# 1 retains routes and persists policy/state across container recreation.
# Listener discovery is always fresh; logos have their own setting below.
#named-volume: /named_volumes/CITADEL /named_volumes/CITADEL/ports.filter.json /opt/safrano9999/CITADEL/ports.filter.json file
#named-volume: /named_volumes/CITADEL /named_volumes/CITADEL/extensions/enabled/cloudflare/routes.json /opt/safrano9999/CITADEL/extensions/enabled/cloudflare/routes.json file
#named-volume: /named_volumes/CITADEL /named_volumes/CITADEL/tailscale.json /opt/safrano9999/CITADEL/tailscale.json link
#choices: 0 1
#default-preset: 0
CITADEL_PERSISTENT=0

# Keep logos independently of policy persistence. Discovery is always fresh.
#named-volume: /named_volumes/CITADEL_LOGOS /named_volumes/CITADEL_LOGOS/icons /opt/safrano9999/CITADEL/icons dir
#choices: 0 1
#default-preset: 1
CITADEL_LOGO_PERSISTENT=1

# Optional: leave empty to disable subnet routes.
CITADEL_SUBNET_IP=

#choices: 0 1
#default-preset: 0
# HTTP services remain visible but are not exposed through providers when enabled.
CITADEL_HTTPS_ONLY=0

# Optional HTTP User-Agent for service discovery; leave empty to use curl's default.
#default-preset: Mozilla/5.0 (compatible; CITADEL/1.0)
CITADEL_USER_AGENT=Mozilla/5.0 (compatible; CITADEL/1.0)

#default-preset: insert later
CITADEL_CLOUDFLARE_DOMAIN=

# Port 443 hostname switches: www443 has priority in dashboard/provider links.
# Set either or both to 1; with both 0, CITADEL uses the numeric 443 hostname.
#default-preset: 0
CITADEL_CLOUDFLARE_WWW443=0
#default-preset: 0
CITADEL_CLOUDFLARE_DOMAIN443=0

#default-preset: insert later
CITADEL_CLOUDFLARE_ACCOUNT_ID=
#default-preset: insert later
CITADEL_CLOUDFLARE_ZONE_ID=
#default-preset: insert later
CITADEL_CLOUDFLARE_TUNNEL_ID=
